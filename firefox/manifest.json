      "toolbar_field_border": "#a9c3cb",
      "toolbar_field_focus": "#deedee",
      "toolbar_field_text_focus": "#1b282d",
      "toolbar_field_border_focus": "#0676ba",
      "toolbar_field_highlight": "#bcd6df",
