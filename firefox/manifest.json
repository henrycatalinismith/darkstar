      "tab_background_separator": "#a9c3cb",
      "toolbar": "#f4f8f1",
      "toolbar_text": "#1b282d",
      "toolbar_top_separator": "#a9c3cb",
      "toolbar_bottom_separator": "#a9c3cb",
      "toolbar_vertical_separator": "#a9c3cb",
      "toolbar_field": "#e9f3f0",
      "toolbar_field_text": "#1b282d",
      "toolbar_field_border": "#a9c3cb",
      "toolbar_field_focus": "#e9f3f0",
      "toolbar_field_text_focus": "#1b282d",
      "toolbar_field_border_focus": "#0676ba",
      "toolbar_field_highlight": "#bcd6df",
