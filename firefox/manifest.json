      "popup_border": "#a9c3cb",
      "popup_highlight": "#bcd6df",
      "popup_highlight_text": "#1b282d",
      "sidebar": "#e9f3f0",
      "sidebar_text": "#1b282d",
      "sidebar_border": "#a9c3cb",
      "sidebar_highlight": "#bcd6df",
      "sidebar_highlight_text": "#1b282d",
      "ntp_background": "#f4f8f1",
      "ntp_text": "#1b282d"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#002029",
      "frame_inactive": "#002029",
      "tab_background_text": "#87979c",
      "tab_selected": "#05181d",
