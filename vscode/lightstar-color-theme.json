  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment", "comment.block.documentation"], "settings": { "foreground": "#617880", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "variable.language"], "settings": { "foreground": "#b30111" } },
    { "scope": ["storage.type.function.arrow"], "settings": { "foreground": "#262626" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "variable", "variable.other", "variable.parameter", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#262626" } },
    { "scope": ["keyword.control.directive", "meta.preprocessor", "entity.name.function.preprocessor", "punctuation.special"], "settings": { "foreground": "#a62801" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#006618" } },
    { "scope": ["string.regexp", "constant.character", "constant.character.escape", "constant.other.symbol"], "settings": { "foreground": "#00837b" } },
    { "scope": ["constant.numeric", "constant.numeric.decimal"], "settings": { "foreground": "#0150c2" } },
    { "scope": ["constant.language.boolean"], "settings": { "foreground": "#00837b" } },
    { "scope": ["constant", "constant.language", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#ab0263" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "support.type.primitive", "entity.name.namespace"], "settings": { "foreground": "#0150c2" } },
    { "scope": ["entity.name.function", "meta.function-call", "support.function", "entity.name.method", "meta.decorator", "entity.other.attribute-name"], "settings": { "foreground": "#00837b" } },
    { "scope": ["support.function.builtin", "support.function.console", "support.function.math"], "settings": { "foreground": "#e10584" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#ab0263" } },
    { "scope": ["entity.name.label"], "settings": { "foreground": "#e10584" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#006618", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#00837b", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#00837b", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#0150c2" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#ab0263" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#006618" } },
    { "scope": ["markup.list", "punctuation.definition.list.begin"], "settings": { "foreground": "#b30111" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#006618" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#b30111" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#a62801" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#b30111" } }
  ],
  "semanticTokenColors": {
    "namespace": "#262626",
    "class": "#0150c2",
    "interface": "#0150c2",
    "enum": "#0150c2",
    "type": "#0150c2",
    "typeParameter": "#ab0263",
    "enumMember": "#00837b",
    "function": "#00837b",
    "method": "#00837b",
    "function.defaultLibrary": "#e10584",
    "macro": "#a62801",
    "variable": "#262626",
    "variable.readonly": "#262626",
    "variable.defaultLibrary": "#b30111",
    "parameter": "#262626",
    "property": "#262626",
    "decorator": "#00837b",
    "keyword": "#b30111",
    "number": "#0150c2",
    "string": "#006618",
    "regexp": "#00837b",
    "comment": { "foreground": "#617880", "italic": true }
  }
}
