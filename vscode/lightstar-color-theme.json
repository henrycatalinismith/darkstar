  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment", "comment.block.documentation"], "settings": { "foreground": "#65747a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "variable.language"], "settings": { "foreground": "#ad000f" } },
    { "scope": ["storage.type.function.arrow"], "settings": { "foreground": "#1b282d" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "variable", "variable.other", "variable.parameter", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#1b282d" } },
    { "scope": ["keyword.control.directive", "meta.preprocessor", "entity.name.function.preprocessor", "punctuation.special"], "settings": { "foreground": "#a12500" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#3c5d03" } },
    { "scope": ["string.regexp", "constant.character", "constant.character.escape", "constant.other.symbol"], "settings": { "foreground": "#0a7f78" } },
    { "scope": ["constant.numeric", "constant.numeric.decimal"], "settings": { "foreground": "#00588d" } },
    { "scope": ["constant.language.boolean"], "settings": { "foreground": "#0a7f78" } },
    { "scope": ["constant", "constant.language", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#a60060" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "support.type.primitive", "entity.name.namespace"], "settings": { "foreground": "#00588d" } },
    { "scope": ["entity.name.function", "meta.function-call", "support.function", "entity.name.method", "meta.decorator", "entity.other.attribute-name"], "settings": { "foreground": "#0a7f78" } },
    { "scope": ["support.function.builtin", "support.function.console", "support.function.math"], "settings": { "foreground": "#db0381" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#a60060" } },
    { "scope": ["entity.name.label"], "settings": { "foreground": "#db0381" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#3c5d03", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#0a7f78", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#0a7f78", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#00588d" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#a60060" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#3c5d03" } },
    { "scope": ["markup.list", "punctuation.definition.list.begin"], "settings": { "foreground": "#ad000f" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#3c5d03" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#ad000f" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#a12500" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ad000f" } }
  ],
  "semanticTokenColors": {
    "namespace": "#1b282d",
    "class": "#00588d",
    "interface": "#00588d",
    "enum": "#00588d",
    "type": "#00588d",
    "typeParameter": "#a60060",
    "enumMember": "#0a7f78",
    "function": "#0a7f78",
    "method": "#0a7f78",
    "function.defaultLibrary": "#db0381",
    "macro": "#a12500",
    "variable": "#1b282d",
    "variable.readonly": "#1b282d",
    "variable.defaultLibrary": "#ad000f",
    "parameter": "#1b282d",
    "property": "#1b282d",
    "decorator": "#0a7f78",
    "keyword": "#ad000f",
    "number": "#00588d",
    "string": "#3c5d03",
    "regexp": "#0a7f78",
    "comment": { "foreground": "#65747a", "italic": true }
  }
}
