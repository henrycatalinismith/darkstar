    "editor.selectionBackground": "#bcd6df",
    "editor.inactiveSelectionBackground": "#bcd6df99",
    "editor.selectionHighlightBackground": "#a9c3cb80",
    "editor.wordHighlightBackground": "#a9c3cb80",
    "editor.wordHighlightStrongBackground": "#a9c3cb",
    "editor.findMatchBackground": "#d5350180",
    "editor.findMatchHighlightBackground": "#d5350140",
    "editor.findRangeHighlightBackground": "#e9f3f0",
