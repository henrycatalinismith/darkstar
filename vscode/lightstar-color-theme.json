    "merge.currentContentBackground": "#d0e7d8",
    "merge.incomingHeaderBackground": "#b0d1ff",
    "merge.incomingContentBackground": "#cfe2ff",

    "gitDecoration.addedResourceForeground": "#006618",
    "gitDecoration.modifiedResourceForeground": "#a62801",
    "gitDecoration.deletedResourceForeground": "#b30111",
    "gitDecoration.renamedResourceForeground": "#0150c2",
    "gitDecoration.untrackedResourceForeground": "#006618",
    "gitDecoration.ignoredResourceForeground": "#a0a0a3",
    "gitDecoration.conflictingResourceForeground": "#a62801",

    "panel.background": "#fcfcff",
    "panel.border": "#bababd",
    "panelTitle.activeForeground": "#262626",
    "panelTitle.inactiveForeground": "#445a62",
    "panelTitle.activeBorder": "#262626",
    "statusBar.background": "#f4f4f8",
    "statusBar.foreground": "#445a62",
    "statusBar.border": "#bababd",
    "statusBar.noFolderBackground": "#f4f4f8",
    "statusBar.debuggingBackground": "#da3701",
    "statusBar.debuggingForeground": "#fcfcff",
    "statusBarItem.remoteBackground": "#006bff",
    "statusBarItem.remoteForeground": "#fcfcff",
    "statusBarItem.hoverBackground": "#bababd",
