    "menu.selectionBackground": "#bababc",
    "menu.separatorBackground": "#bababd",

    "editorGroup.border": "#bababd",
    "editorGroupHeader.tabsBackground": "#f4f4f8",
    "editorGroupHeader.tabsBorder": "#bababd",
    "tab.activeBackground": "#fcfcff",
    "tab.activeForeground": "#262626",
    "tab.activeBorderTop": "#006bff",
    "tab.inactiveBackground": "#f4f4f8",
    "tab.inactiveForeground": "#445a62",
    "tab.border": "#bababd",
    "tab.hoverBackground": "#fcfcff",
    "breadcrumb.foreground": "#445a62",
    "breadcrumb.focusForeground": "#262626",
