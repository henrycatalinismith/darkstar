    "terminal.background": "#fcfcff",
    "terminal.foreground": "#262626",
    "terminalCursor.foreground": "#646467",
    "terminal.selectionBackground": "#bababc",
    "terminal.ansiBlack": "#617880",
    "terminal.ansiRed": "#ea031a",
    "terminal.ansiGreen": "#058824",
    "terminal.ansiYellow": "#996d04",
    "terminal.ansiBlue": "#006bff",
    "terminal.ansiMagenta": "#e10584",
    "terminal.ansiCyan": "#00837b",
    "terminal.ansiWhite": "#262626",
    "terminal.ansiBrightBlack": "#445a62",
    "terminal.ansiBrightRed": "#b30111",
    "terminal.ansiBrightGreen": "#006618",
    "terminal.ansiBrightYellow": "#745104",
    "terminal.ansiBrightBlue": "#0150c2",
    "terminal.ansiBrightMagenta": "#ab0263",
    "terminal.ansiBrightCyan": "#09625c",
    "terminal.ansiBrightWhite": "#000000"
