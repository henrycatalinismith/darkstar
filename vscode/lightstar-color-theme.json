    "editorCodeLens.foreground": "#526165",
    "editorLink.activeForeground": "#00588d",
    "editorInlayHint.foreground": "#526165",
    "editorInlayHint.background": "#00000000",
    "editorGutter.background": "#f4f8f1",
    "editorGutter.addedBackground": "#517e03",
    "editorGutter.modifiedBackground": "#d53501",
    "editorGutter.deletedBackground": "#e40018",
    "editorError.foreground": "#ad000f",
    "editorWarning.foreground": "#a12500",
    "editorInfo.foreground": "#00588d",
    "editorHint.foreground": "#3c5d03",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#e40018",
    "editorOverviewRuler.warningForeground": "#d53501",
    "editorOverviewRuler.infoForeground": "#0676ba",
    "editorWidget.background": "#e9f3f0",
    "editorWidget.border": "#a9c3cb",
    "editorSuggestWidget.background": "#e9f3f0",
    "editorSuggestWidget.border": "#a9c3cb",
    "editorSuggestWidget.selectedBackground": "#bcd6df",
    "editorSuggestWidget.highlightForeground": "#00588d",
    "editorHoverWidget.background": "#e9f3f0",
    "editorHoverWidget.border": "#a9c3cb",
    "peekView.border": "#0676ba",
    "peekViewEditor.background": "#e9f3f0",
    "peekViewResult.background": "#e9f3f0",
    "peekViewTitle.background": "#e9f3f0",
    "minimap.background": "#f4f8f1",

    "diffEditor.insertedTextBackground": "#b5df8a",
    "diffEditor.removedTextBackground": "#febcb6",
    "diffEditor.insertedLineBackground": "#d0efb4",
    "diffEditor.removedLineBackground": "#fed8d4",
    "merge.currentHeaderBackground": "#b5df8a",
    "merge.currentContentBackground": "#d0efb4",
    "merge.incomingHeaderBackground": "#9fd2fe",
    "merge.incomingContentBackground": "#cfe8fe",

    "gitDecoration.addedResourceForeground": "#3c5d03",
    "gitDecoration.modifiedResourceForeground": "#a12500",
    "gitDecoration.deletedResourceForeground": "#ad000f",
    "gitDecoration.renamedResourceForeground": "#00588d",
    "gitDecoration.untrackedResourceForeground": "#3c5d03",
    "gitDecoration.ignoredResourceForeground": "#7f979f",
    "gitDecoration.conflictingResourceForeground": "#a12500",

    "panel.background": "#f4f8f1",
    "panel.border": "#a9c3cb",
    "panelTitle.activeForeground": "#1b282d",
    "panelTitle.inactiveForeground": "#526165",
    "panelTitle.activeBorder": "#1b282d",
    "statusBar.background": "#e9f3f0",
    "statusBar.foreground": "#526165",
    "statusBar.border": "#a9c3cb",
