    "editor.selectionBackground": "#bababc",
    "editor.inactiveSelectionBackground": "#bababc99",
    "editor.selectionHighlightBackground": "#bababd80",
    "editor.wordHighlightBackground": "#bababd80",
    "editor.wordHighlightStrongBackground": "#bababd",
    "editor.findMatchBackground": "#da370180",
    "editor.findMatchHighlightBackground": "#da370140",
    "editor.findRangeHighlightBackground": "#f4f4f8",
    "editor.rangeHighlightBackground": "#f4f4f8",
    "editor.foldBackground": "#f4f4f8",
    "editorBracketMatch.background": "#f4f4f8",
    "editorBracketMatch.border": "#a0a0a3",
    "editorWhitespace.foreground": "#bababd",
    "editorIndentGuide.background1": "#bababd",
    "editorIndentGuide.activeBackground1": "#a0a0a3",
    "editorRuler.foreground": "#bababd",
    "editorCodeLens.foreground": "#445a62",
    "editorLink.activeForeground": "#0150c2",
    "editorInlayHint.foreground": "#445a62",
    "editorInlayHint.background": "#00000000",
    "editorGutter.background": "#fcfcff",
    "editorGutter.addedBackground": "#058824",
    "editorGutter.modifiedBackground": "#da3701",
    "editorGutter.deletedBackground": "#ea031a",
    "editorError.foreground": "#b30111",
    "editorWarning.foreground": "#a62801",
    "editorInfo.foreground": "#0150c2",
    "editorHint.foreground": "#006618",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#ea031a",
    "editorOverviewRuler.warningForeground": "#da3701",
    "editorOverviewRuler.infoForeground": "#006bff",
    "editorWidget.background": "#f4f4f8",
    "editorWidget.border": "#bababd",
    "editorSuggestWidget.background": "#f4f4f8",
    "editorSuggestWidget.border": "#bababd",
    "editorSuggestWidget.selectedBackground": "#bababc",
    "editorSuggestWidget.highlightForeground": "#0150c2",
    "editorHoverWidget.background": "#f4f4f8",
    "editorHoverWidget.border": "#bababd",
    "peekView.border": "#006bff",
    "peekViewEditor.background": "#f4f4f8",
    "peekViewResult.background": "#f4f4f8",
    "peekViewTitle.background": "#f4f4f8",
    "minimap.background": "#fcfcff",

    "diffEditor.insertedTextBackground": "#b2d9bd",
    "diffEditor.removedTextBackground": "#f7b1ba",
    "diffEditor.insertedLineBackground": "#d0e7d8",
    "diffEditor.removedLineBackground": "#f9cfd6",
