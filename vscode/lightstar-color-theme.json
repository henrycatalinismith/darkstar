    "terminal.ansiCyan": "#0a7f78",
    "terminal.ansiWhite": "#38474b",
    "terminal.ansiBrightBlack": "#526165",
    "terminal.ansiBrightRed": "#ad000f",
    "terminal.ansiBrightGreen": "#3c5d03",
    "terminal.ansiBrightYellow": "#6c5000",
    "terminal.ansiBrightBlue": "#00588d",
    "terminal.ansiBrightMagenta": "#a60060",
    "terminal.ansiBrightCyan": "#025f5a",
    "terminal.ansiBrightWhite": "#1b282d"
