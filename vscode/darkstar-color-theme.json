  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment", "comment.block.documentation"], "settings": { "foreground": "#728186", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "variable.language"], "settings": { "foreground": "#ff776b" } },
    { "scope": ["storage.type.function.arrow"], "settings": { "foreground": "#d4e5ea" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "variable", "variable.other", "variable.parameter", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#d4e5ea" } },
    { "scope": ["keyword.control.directive", "meta.preprocessor", "entity.name.function.preprocessor", "punctuation.special"], "settings": { "foreground": "#fe7958" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#95ab07" } },
    { "scope": ["string.regexp", "constant.character", "constant.character.escape", "constant.other.symbol"], "settings": { "foreground": "#ca9a01" } },
    { "scope": ["constant.numeric", "constant.numeric.decimal"], "settings": { "foreground": "#39a8f8" } },
    { "scope": ["constant.language.boolean"], "settings": { "foreground": "#ca9a01" } },
    { "scope": ["constant", "constant.language", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#ff6ead" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "support.type.primitive", "entity.name.namespace"], "settings": { "foreground": "#39a8f8" } },
    { "scope": ["entity.name.function", "meta.function-call", "support.function", "entity.name.method", "meta.decorator", "entity.other.attribute-name"], "settings": { "foreground": "#ca9a01" } },
    { "scope": ["support.function.builtin", "support.function.console", "support.function.math"], "settings": { "foreground": "#e5348c" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#ff6ead" } },
    { "scope": ["entity.name.label"], "settings": { "foreground": "#e5348c" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#95ab07", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#ca9a01", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#ca9a01", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#39a8f8" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#ff6ead" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#95ab07" } },
    { "scope": ["markup.list", "punctuation.definition.list.begin"], "settings": { "foreground": "#ff776b" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#95ab07" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#ff776b" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#ca9a01" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff776b" } }
  ],
  "semanticTokenColors": {
    "namespace": "#d4e5ea",
    "class": "#39a8f8",
    "interface": "#39a8f8",
    "enum": "#39a8f8",
    "type": "#39a8f8",
    "typeParameter": "#ff6ead",
    "enumMember": "#ca9a01",
    "function": "#ca9a01",
    "method": "#ca9a01",
    "function.defaultLibrary": "#e5348c",
    "macro": "#fe7958",
    "variable": "#d4e5ea",
    "variable.readonly": "#d4e5ea",
    "variable.defaultLibrary": "#ff776b",
    "parameter": "#d4e5ea",
    "property": "#d4e5ea",
    "decorator": "#ca9a01",
    "keyword": "#ff776b",
    "number": "#39a8f8",
    "string": "#95ab07",
    "regexp": "#ca9a01",
    "comment": { "foreground": "#728186", "italic": true }
  }
}
