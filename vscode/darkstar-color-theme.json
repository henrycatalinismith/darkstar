    "terminal.selectionBackground": "#163f4b",
    "terminal.ansiBlack": "#728186",
    "terminal.ansiRed": "#f1302f",
    "terminal.ansiGreen": "#758705",
    "terminal.ansiYellow": "#9f7903",
    "terminal.ansiBlue": "#0484ce",
    "terminal.ansiMagenta": "#e5348c",
