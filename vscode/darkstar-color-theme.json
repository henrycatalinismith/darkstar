  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment", "comment.block.documentation"], "settings": { "foreground": "#6c838b", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "variable.language"], "settings": { "foreground": "#ff796e" } },
    { "scope": ["storage.type.function.arrow"], "settings": { "foreground": "#eee8d5" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "variable", "variable.other", "variable.parameter", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#eee8d5" } },
    { "scope": ["keyword.control.directive", "meta.preprocessor", "entity.name.function.preprocessor", "punctuation.special"], "settings": { "foreground": "#ed8649" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#83c746" } },
    { "scope": ["string.regexp", "constant.character", "constant.character.escape", "constant.other.symbol"], "settings": { "foreground": "#efc541" } },
    { "scope": ["constant.numeric", "constant.numeric.decimal"], "settings": { "foreground": "#5da4ff" } },
    { "scope": ["constant.language.boolean"], "settings": { "foreground": "#efc541" } },
    { "scope": ["constant", "constant.language", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#ff81ca" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "support.type.primitive", "entity.name.namespace"], "settings": { "foreground": "#5da4ff" } },
    { "scope": ["entity.name.function", "meta.function-call", "support.function", "entity.name.method", "meta.decorator", "entity.other.attribute-name"], "settings": { "foreground": "#efc541" } },
    { "scope": ["support.function.builtin", "support.function.console", "support.function.math"], "settings": { "foreground": "#de428c" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#ff81ca" } },
    { "scope": ["entity.name.label"], "settings": { "foreground": "#de428c" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#83c746", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#efc541", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#efc541", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#5da4ff" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#ff81ca" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#83c746" } },
    { "scope": ["markup.list", "punctuation.definition.list.begin"], "settings": { "foreground": "#ff796e" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#83c746" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#ff796e" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#efc541" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff796e" } }
  ],
  "semanticTokenColors": {
    "namespace": "#eee8d5",
    "class": "#5da4ff",
    "interface": "#5da4ff",
    "enum": "#5da4ff",
    "type": "#5da4ff",
    "typeParameter": "#ff81ca",
    "enumMember": "#efc541",
    "function": "#efc541",
    "method": "#efc541",
    "function.defaultLibrary": "#de428c",
    "macro": "#ed8649",
    "variable": "#eee8d5",
    "variable.readonly": "#eee8d5",
    "variable.defaultLibrary": "#ff796e",
    "parameter": "#eee8d5",
    "property": "#eee8d5",
    "decorator": "#efc541",
    "keyword": "#ff796e",
    "number": "#5da4ff",
    "string": "#83c746",
    "regexp": "#efc541",
    "comment": { "foreground": "#6c838b", "italic": true }
  }
}
