    "editorBracketMatch.background": "#002029",
    "editorBracketMatch.border": "#475b62",
    "editorWhitespace.foreground": "#204a56",
    "editorIndentGuide.background1": "#204a56",
    "editorIndentGuide.activeBackground1": "#475b62",
    "editorRuler.foreground": "#204a56",
    "editorCodeLens.foreground": "#87979c",
    "editorLink.activeForeground": "#39a8f8",
    "editorInlayHint.foreground": "#87979c",
    "editorInlayHint.background": "#00000000",
    "editorGutter.background": "#05181d",
    "editorGutter.addedBackground": "#758705",
    "editorGutter.modifiedBackground": "#9f7903",
    "editorGutter.deletedBackground": "#f1302f",
    "editorError.foreground": "#ff776b",
    "editorWarning.foreground": "#ca9a01",
    "editorInfo.foreground": "#39a8f8",
    "editorHint.foreground": "#95ab07",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#f1302f",
    "editorOverviewRuler.warningForeground": "#9f7903",
    "editorOverviewRuler.infoForeground": "#0484ce",
    "editorWidget.background": "#002029",
    "editorWidget.border": "#204a56",
    "editorSuggestWidget.background": "#002029",
    "editorSuggestWidget.border": "#204a56",
    "editorSuggestWidget.selectedBackground": "#163f4b",
