    "terminal.ansiWhite": "#a9babf",
    "terminal.ansiBrightBlack": "#87979c",
    "terminal.ansiBrightRed": "#ff776b",
    "terminal.ansiBrightGreen": "#95ab07",
    "terminal.ansiBrightYellow": "#ca9a01",
    "terminal.ansiBrightBlue": "#39a8f8",
